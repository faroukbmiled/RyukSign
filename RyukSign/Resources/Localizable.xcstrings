    "Changing the port or password restarts the server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير المنفذ أو كلمة المرور يعيد تشغيل الخادم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změna portu nebo hesla restartuje server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern von Port oder Passwort startet den Server neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el puerto o la contraseña reinicia el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le port ou le mot de passe redémarre le serveur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah port atau kata sandi akan memulai ulang server."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica della porta o della password riavvia il server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana portu lub hasła powoduje ponowne uruchomienie serwera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение порта или пароля перезапускает сервер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port veya şifreyi değiştirmek sunucuyu yeniden başlatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi cổng hoặc mật khẩu sẽ khởi động lại máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改端口或密码会重启服务器。"
          }
        }
      }
    },
    "Changing the port or password restarts the server. Traffic is sent over your local network unencrypted, so only run this on a network you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير المنفذ أو كلمة المرور يعيد تشغيل الخادم. تُرسَل البيانات عبر شبكتك المحلية دون تشفير، لذا شغّله فقط على شبكة تثق بها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změna portu nebo hesla restartuje server. Data se přenášejí po místní síti nešifrovaně, proto jej spouštějte jen v síti, které důvěřujete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern von Port oder Passwort startet den Server neu. Der Datenverkehr wird unverschlüsselt über dein lokales Netzwerk gesendet — nutze ihn nur in einem Netzwerk, dem du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the port or password restarts the server. Traffic is sent over your local network unencrypted, so only run this on a network you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el puerto o la contraseña reinicia el servidor. El tráfico se envía sin cifrar por tu red local, así que úsalo solo en una red de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier le port ou le mot de passe redémarre le serveur. Les données transitent en clair sur votre réseau local : ne l'utilisez que sur un réseau de confiance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah port atau kata sandi akan memulai ulang server. Lalu lintas dikirim melalui jaringan lokal tanpa enkripsi, jadi jalankan hanya di jaringan yang Anda percaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica della porta o della password riavvia il server. Il traffico viaggia sulla rete locale senza crittografia, quindi usalo solo su una rete affidabile."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana portu lub hasła ponownie uruchamia serwer. Ruch jest przesyłany przez sieć lokalną bez szyfrowania, więc używaj go tylko w zaufanej sieci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменение порта или пароля перезапускает сервер. Данные передаются по локальной сети без шифрования, поэтому используйте его только в доверенной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Port veya şifreyi değiştirmek sunucuyu yeniden başlatır. Veriler yerel ağ üzerinden şifrelenmeden gönderilir, bu yüzden yalnızca güvendiğiniz bir ağda kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi cổng hoặc mật khẩu sẽ khởi động lại máy chủ. Dữ liệu được gửi qua mạng cục bộ không mã hóa, vì vậy chỉ chạy trên mạng mà bạn tin tưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改端口或密码会重启服务器。数据通过本地网络以未加密方式传输，请仅在受信任的网络上使用。"
          }
        }
      }
    },

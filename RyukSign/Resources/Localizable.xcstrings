    "The source returned no data. If this is a premium source, your access may have expired or failed to authenticate." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُرجع المصدر أي بيانات. إذا كان هذا مصدرًا مميزًا، فقد تكون صلاحية وصولك قد انتهت أو فشلت المصادقة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdroj nevrátil žádná data. Pokud jde o prémiový zdroj, váš přístup mohl vypršet nebo se nepodařilo ověřit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle hat keine Daten zurückgegeben. Wenn dies eine Premium-Quelle ist, ist dein Zugang möglicherweise abgelaufen oder die Authentifizierung ist fehlgeschlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente no devolvió datos. Si es una fuente premium, puede que tu acceso haya caducado o que la autenticación haya fallado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La source n’a renvoyé aucune donnée. S’il s’agit d’une source premium, votre accès a peut-être expiré ou l’authentification a échoué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sumber tidak mengembalikan data. Jika ini sumber premium, akses Anda mungkin telah kedaluwarsa atau gagal diautentikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fonte non ha restituito dati. Se è una fonte premium, il tuo accesso potrebbe essere scaduto o l'autenticazione potrebbe non essere riuscita."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło nie zwróciło żadnych danych. Jeśli to źródło premium, Twój dostęp mógł wygasnąć lub uwierzytelnienie się nie powiodło."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Источник не вернул данных. Если это премиум-источник, возможно, ваш доступ истёк или не удалось пройти аутентификацию."
          }
        },
        "tr" : {

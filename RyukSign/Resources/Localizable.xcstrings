          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDevice: pembaruan ditandatangani di perangkat dan dipasang melalui berkas pemasangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDevice: l'aggiornamento viene firmato sul dispositivo e installato tramite un file di associazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",

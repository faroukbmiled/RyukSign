    "Pair this with the tweak that reads it — a bundle alone does nothing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرن هذا مع التعديل الذي يقرأه — الـ bundle وحده لا يفعل شيئًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spárujte to s tweakem, který to čte — samotný bundle nic nedělá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombiniere dies mit dem Tweak, der es liest — ein Bundle allein bewirkt nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina esto con el tweak que lo lee — un bundle por sí solo no hace nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez-le au tweak qui le lit — un bundle seul ne fait rien."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",

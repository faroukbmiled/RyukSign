    "Saved every time you export or share an IPA. Safe to delete." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ في كل مرة تصدّر أو تشارك ملف IPA. حذفها آمن."
          }
        },
        "cs" : {
          "stringUnit" : {

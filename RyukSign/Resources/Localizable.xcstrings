    "Automatically open a live log console when signing starts. You can also open it from the Show Logs button while a sign is running." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح وحدة سجلات مباشرة تلقائياً عند بدء التوقيع. يمكنك أيضاً فتحها من زر عرض السجلات أثناء تشغيل التوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zahájení podepisování automaticky otevře živou konzoli protokolů. Můžete ji také otevřít tlačítkem Zobrazit protokoly během podepisování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet beim Start des Signierens automatisch eine Live-Protokollkonsole. Du kannst sie während eines laufenden Vorgangs auch über „Protokolle anzeigen“ öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically open a live log console when signing starts. You can also open it from the Show Logs button while a sign is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre automáticamente una consola de registros en vivo al iniciar la firma. También puedes abrirla con el botón Mostrar registros mientras se firma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre automatiquement une console de journaux en direct au démarrage de la signature. Vous pouvez aussi l’ouvrir via le bouton Afficher les journaux pendant la signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis membuka konsol log langsung saat penandatanganan dimulai. Kamu juga bisa membukanya dari tombol Tampilkan Log selama proses berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre automaticamente una console di log in tempo reale all’avvio della firma. Puoi aprirla anche dal pulsante Mostra log mentre una firma è in corso."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatycznie otwiera konsolę dzienników na żywo po rozpoczęciu podpisywania. Możesz ją też otworzyć przyciskiem Pokaż dzienniki w trakcie podpisywania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически открывает живую консоль журналов при начале подписи. Её также можно открыть кнопкой «Показать журналы» во время подписи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzalama başladığında canlı bir günlük konsolunu otomatik açar. İmzalama sürerken Günlükleri Göster düğmesinden de açabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động mở bảng nhật ký trực tiếp khi bắt đầu ký. Bạn cũng có thể mở từ nút Hiện nhật ký khi đang ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签名开始时自动打开实时日志控制台。签名进行中也可通过“显示日志”按钮打开。"
          }
        }
      }
    },

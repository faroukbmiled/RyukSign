    "Drag to reorder (tap Edit). Hidden tabs stay reachable from Settings — the Settings tab can't be hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة الترتيب (اضغط تحرير). تبقى علامات التبويب المخفية متاحة من الإعدادات — لا يمكن إخفاء علامة تبويب الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přetažením změníte pořadí (klepněte na Upravit). Skryté karty zůstávají dostupné z Nastavení — kartu Nastavení nelze skrýt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Neuordnen ziehen (auf Bearbeiten tippen). Ausgeblendete Tabs bleiben über die Einstellungen erreichbar — der Einstellungen-Tab kann nicht ausgeblendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar (toca Editar). Las pestañas ocultas siguen accesibles desde Ajustes — la pestaña Ajustes no se puede ocultar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser (touchez Modifier). Les onglets masqués restent accessibles depuis Réglages — l’onglet Réglages ne peut pas être masqué."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser untuk menyusun ulang (ketuk Edit). Tab tersembunyi tetap dapat diakses dari Pengaturan — tab Pengaturan tidak bisa disembunyikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare (tocca Modifica). Le schede nascoste restano raggiungibili dalle Impostazioni — la scheda Impostazioni non può essere nascosta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność (dotknij Edytuj). Ukryte karty pozostają dostępne z Ustawień — karty Ustawienia nie można ukryć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте для изменения порядка (нажмите «Править»). Скрытые вкладки остаются доступны в настройках — вкладку «Настройки» скрыть нельзя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sıralamak için sürükleyin (Düzenle'ye dokunun). Gizli sekmelere Ayarlar'dan ulaşılabilir — Ayarlar sekmesi gizlenemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại (chạm Sửa). Các tab bị ẩn vẫn truy cập được từ Cài đặt — không thể ẩn tab Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以重新排序（点按编辑）。隐藏的标签页仍可从设置中访问——设置标签页无法隐藏。"
          }
        }
      }
    },

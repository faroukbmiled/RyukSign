    "Clears caches, logs, temp files and leftovers. Your apps, tweaks and certificates stay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح الذاكرة المؤقتة والسجلات والملفات المؤقتة والبقايا. تبقى تطبيقاتك وتعديلاتك وشهاداتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vymaže mezipaměť, protokoly, dočasné soubory a zbytky. Aplikace, tweaky a certifikáty zůstanou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Caches, Protokolle, Temp-Dateien und Reste. Deine Apps, Tweaks und Zertifikate bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears caches, logs, temp files and leftovers. Your apps, tweaks and certificates stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra cachés, registros, archivos temp y sobrantes. Tus apps, tweaks y certificados se quedan."
          }
        },
        "fr" : {

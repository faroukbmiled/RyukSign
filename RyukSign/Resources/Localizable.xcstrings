    "Swipe left to reset. Premium repos cannot be deleted individually." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليسار لإعادة التعيين. لا يمكن حذف المستودعات المميزة بشكل فردي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeďte vlevo pro reset. Premium repozitáře nelze mazat jednotlivě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zurücksetzen nach links wischen. Premium-Repos können nicht einzeln gelöscht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para restablecer. Los repos premium no se pueden eliminar individualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers la gauche pour réinitialiser. Les dépôts premium ne peuvent pas être supprimés individuellement."

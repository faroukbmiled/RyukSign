    "Self-update needs the IDevice install method with a pairing file. Set it up under Installation." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج التحديث الذاتي إلى طريقة تثبيت IDevice مع ملف اقتران. قم بإعداده من قسم التثبيت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatická aktualizace potřebuje metodu instalace IDevice s párovacím souborem. Nastavte ji v sekci Instalace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Selbstaktualisierung benötigt die IDevice-Installationsmethode mit einer Pairing-Datei. Richte sie unter Installation ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Self-update needs the IDevice install method with a pairing file. Set it up under Installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La autoactualización necesita el método de instalación IDevice con un archivo de emparejamiento. Configúralo en Instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mise à jour automatique nécessite la méthode d'installation IDevice avec un fichier d'appairage. Configurez-la dans Installation."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembaruan mandiri memerlukan metode instalasi IDevice dengan berkas pemasangan. Atur di bagian Instalasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'aggiornamento automatico richiede il metodo di installazione IDevice con un file di associazione. Configuralo in Installazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodzielna aktualizacja wymaga metody instalacji IDevice z plikiem parowania. Skonfiguruj ją w sekcji Instalacja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для самообновления нужен способ установки IDevice с файлом сопряжения. Настройте его в разделе «Установка»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi kendine güncelleme, eşleştirme dosyasıyla IDevice kurulum yöntemini gerektirir. Kurulum bölümünden yapılandırın."
          }
        },
        "vi" : {
          "stringUnit" : {

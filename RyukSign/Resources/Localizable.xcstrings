    "Long-press an app in Sources and choose Ignore Updates. Ignored apps appear here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولاً على تطبيق في المصادر واختر تجاهل التحديثات. تظهر التطبيقات المتجاهَلة هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte aplikaci v Zdrojích a zvolte Ignorovat aktualizace. Ignorované aplikace se zobrazí zde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine App in den Quellen gedrückt und wähle „Updates ignorieren“. Ignorierte Apps erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una app en Fuentes y elige Ignorar actualizaciones. Las apps ignoradas aparecen aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une app dans Sources et choisissez Ignorer les mises à jour. Les apps ignorées apparaissent ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekan lama sebuah aplikasi di Sources dan pilih Abaikan Pembaruan. Aplikasi yang diabaikan muncul di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta un'app nelle Fonti e scegli Ignora aggiornamenti. Le app ignorate compaiono qui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naciśnij i przytrzymaj aplikację w Źródłach i wybierz Ignoruj aktualizacje. Ignorowane aplikacje pojawią się tutaj."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите и удерживайте приложение в «Источниках» и выберите «Игнорировать обновления». Игнорируемые приложения появятся здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources'taki bir uygulamaya uzun basıp Güncellemeleri Yoksay'ı seçin. Yoksayılan uygulamalar burada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ một ứng dụng trong Sources và chọn Bỏ qua cập nhật. Các ứng dụng bị bỏ qua sẽ xuất hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Sources 中长按某个应用并选择忽略更新。被忽略的应用会显示在这里。"
          }
        }
      }
    },
    "Main app only" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {

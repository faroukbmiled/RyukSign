    "Scratch files used while importing, signing, and downloading. They are recreated whenever they are needed again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات عمل تُستخدم أثناء الاستيراد والتوقيع والتنزيل. تُنشأ من جديد كلما احتيج إليها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pracovní soubory používané při importu, podepisování a stahování. Vytvoří se znovu, kdykoli budou opět potřeba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsdateien, die beim Importieren, Signieren und Herunterladen verwendet werden. Sie werden bei Bedarf neu erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scratch files used while importing, signing, and downloading. They are recreated whenever they are needed again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos de trabajo usados al importar, firmar y descargar. Se vuelven a crear cuando hacen falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers de travail utilisés lors des imports, signatures et téléchargements. Ils sont recréés dès qu'ils sont à nouveau nécessaires."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berkas kerja yang dipakai saat mengimpor, menandatangani, dan mengunduh. Berkas ini dibuat ulang setiap kali dibutuhkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di lavoro usati durante importazione, firma e download. Vengono ricreati ogni volta che servono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki robocze używane podczas importu, podpisywania i pobierania. Są tworzone ponownie, gdy znów będą potrzebne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочие файлы, используемые при импорте, подписании и загрузке. Они создаются заново, когда снова нужны."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarma, imzalama ve indirme sırasında kullanılan geçici çalışma dosyaları. Yeniden gerektiğinde tekrar oluşturulurlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các tệp làm việc dùng khi nhập, ký và tải xuống. Chúng sẽ được tạo lại mỗi khi cần đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

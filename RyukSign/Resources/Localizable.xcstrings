    "Placed in PlugIns/ and re-signed as an extension of the host app (its bundle id becomes a child of the app's)." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُضع في ‎PlugIns/‎ وأُعيد توقيعه كإضافة للتطبيق المضيف (يصبح bundle id الخاص به تابعًا لمعرّف التطبيق)."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umístěno do PlugIns/ a znovu podepsáno jako rozšíření hostitelské aplikace (jeho bundle ID se stane potomkem ID aplikace)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In PlugIns/ abgelegt und als Erweiterung der Host-App neu signiert (ihre Bundle-ID wird zu einer untergeordneten der App)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocado en PlugIns/ y refirmado como una extensión de la app anfitriona (su bundle id pasa a ser hijo del de la app)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placé dans PlugIns/ et resigné comme une extension de l’app hôte (son bundle ID devient un enfant de celui de l’app)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditempatkan di PlugIns/ dan ditandatangani ulang sebagai extension dari aplikasi induk (bundle id-nya menjadi turunan dari aplikasi)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserito in PlugIns/ e rifirmato come estensione dell'app host (il suo bundle ID diventa un figlio di quello dell'app)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieszczone w PlugIns/ i ponownie podpisane jako rozszerzenie aplikacji hosta (jego bundle ID staje się podrzędne wobec bundle ID aplikacji)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помещено в PlugIns/ и переподписано как расширение основного приложения (его bundle ID становится дочерним для приложения)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PlugIns/ klasörüne yerleştirildi ve ana uygulamanın bir uzantısı olarak yeniden imzalandı (bundle kimliği, uygulamanınkinin alt öğesi olur)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được đặt trong PlugIns/ và ký lại như một extension của ứng dụng chủ (bundle ID của nó trở thành con của ứng dụng)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放入 PlugIns/ 并作为宿主应用的扩展重新签名（其 bundle ID 成为应用 ID 的子级）。"

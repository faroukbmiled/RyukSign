    "This will delete your imported application after signing, to save on using unneeded space." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف التطبيق المستورد بعد التوقيع لتوفير المساحة غير الضرورية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se vaše importovaná aplikace po podepsání odstraní, aby se ušetřilo zbytečné místo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird deine importierte Datei nach der Signierung löschen, um an unnötigen Speicher zu sparen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete your imported application after signing, to save on using unneeded space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará tu aplicación importada después de firmar, para ahorrar espacio innecesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera votre application importée après la signature, afin d'économiser de l'espace inutile."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus aplikasi yang Anda impor setelah penandatanganan, untuk menghemat penggunaan ruang yang tidak perlu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina l'applicazione importata dopo la firma, per salvare spazio usato inutilmente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie zaimportowanej aplikacji po jej podpisaniu, co pozwoli zwolnić miejsce."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит импортированное приложение после подписи, чтобы сэкономить место."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, imzaladıktan sonra içe aktarılan uygulamayı silerek gereksiz alanı geri kazanmanıza yardımcı olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa ứng dụng đã nhập của bạn sau khi ký, để tiết kiệm dung lượng không cần thiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在签名后删除导入的应用来节省空间。"
          }
        }
      }
    },
    "This will remove all RyukSign premium repositories and clear your activation. You will need a new key to reactivate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى إزالة جميع مستودعات RyukSign المميزة ومسح تفعيلك. ستحتاج إلى مفتاح جديد لإعادة التفعيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto se odstraní všechny premium repozitáře RyukSign a vymaže vaše aktivace. K opětovné aktivaci budete potřebovat nový klíč."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle RyukSign-Premium-Repositories entfernt und deine Aktivierung gelöscht. Zum erneuten Aktivieren benötigst du einen neuen Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los repositorios premium de RyukSign y borrará tu activación. Necesitarás una nueva clave para reactivarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera tous les dépôts premium RyukSign et effacera votre activation. Vous aurez besoin d'une nouvelle clé pour réactiver."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua repositori premium RyukSign dan menghapus aktivasi Anda. Anda akan memerlukan kunci baru untuk mengaktifkan kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuoverà tutti i repository premium di RyukSign e cancellerà la tua attivazione. Avrai bisogno di una nuova chiave per riattivare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie wszystkich repozytoriów premium RyukSign i wyczyszczenie aktywacji. Do ponownej aktywacji będziesz potrzebować nowego klucza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все премиум-репозитории RyukSign и очистит вашу активацию. Для повторной активации потребуется новый ключ."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm RyukSign premium depolarını kaldırır ve etkinleştirmenizi temizler. Yeniden etkinleştirmek için yeni bir anahtara ihtiyacınız olacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa tất cả các kho premium RyukSign và xóa kích hoạt của bạn. Bạn sẽ cần một khóa mới để kích hoạt lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将移除所有 RyukSign 高级仓库并清除你的激活记录。你将需要一个新密钥才能重新激活。"
          }
        }
      }
    },

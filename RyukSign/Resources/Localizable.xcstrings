    "Needs CydiaSubstrate. The app doesn't include it, so RyukSign adds ElleKit automatically when signing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج إلى CydiaSubstrate. التطبيق لا يتضمنه، لذا يضيف RyukSign بديل ElleKit تلقائيًا عند التوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžaduje CydiaSubstrate. Aplikace ho neobsahuje, takže RyukSign při podepisování automaticky přidá ElleKit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benötigt CydiaSubstrate. Die App enthält es nicht, daher fügt RyukSign beim Signieren automatisch ElleKit hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesita CydiaSubstrate. La app no lo incluye, así que RyukSign añade ElleKit automáticamente al firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite CydiaSubstrate. L’app ne l’inclut pas, donc RyukSign ajoute automatiquement ElleKit lors de la signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membutuhkan CydiaSubstrate. Aplikasi tidak menyertakannya, jadi RyukSign menambahkan ElleKit secara otomatis saat menandatangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

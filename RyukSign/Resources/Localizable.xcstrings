    "Hooks via CydiaSubstrate — the app already includes it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يربط عبر CydiaSubstrate — التطبيق يتضمنه بالفعل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Háčkuje přes CydiaSubstrate — aplikace ho již obsahuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hookt über CydiaSubstrate — die App enthält es bereits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engancha mediante CydiaSubstrate — la app ya lo incluye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accroche via CydiaSubstrate — l’app l’inclut déjà."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaitkan melalui CydiaSubstrate — aplikasi sudah menyertakannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggancia tramite CydiaSubstrate — l'app lo include già."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuje poprzez CydiaSubstrate — aplikacja już go zawiera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перехватывает через CydiaSubstrate — приложение уже содержит его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CydiaSubstrate üzerinden hook yapar — uygulama bunu zaten içeriyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hook qua CydiaSubstrate — ứng dụng đã có sẵn nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 CydiaSubstrate 进行 hook——应用已包含它。"
          }
        }
      }
    },
    "Hooks via CydiaSubstrate. The app doesn't include it, so RyukSign adds ElleKit (a Substrate replacement) automatically when signing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يربط عبر CydiaSubstrate. التطبيق لا يتضمنه، لذا يضيف RyukSign بديل ElleKit تلقائيًا عند التوقيع."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Háčkuje přes CydiaSubstrate. Aplikace ho neobsahuje, takže RyukSign při podepisování automaticky přidá ElleKit (náhradu za Substrate)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hookt über CydiaSubstrate. Die App enthält es nicht, daher fügt RyukSign beim Signieren automatisch ElleKit (einen Substrate-Ersatz) hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engancha mediante CydiaSubstrate. La app no lo incluye, así que RyukSign añade ElleKit (un reemplazo de Substrate) automáticamente al firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accroche via CydiaSubstrate. L’app ne l’inclut pas, donc RyukSign ajoute automatiquement ElleKit (un remplacement de Substrate) lors de la signature."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaitkan melalui CydiaSubstrate. Aplikasi tidak menyertakannya, jadi RyukSign menambahkan ElleKit (pengganti Substrate) secara otomatis saat menandatangani."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggancia tramite CydiaSubstrate. L'app non lo include, quindi RyukSign aggiunge automaticamente ElleKit (un sostituto di Substrate) durante la firma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakuje poprzez CydiaSubstrate. Aplikacja go nie zawiera, więc RyukSign automatycznie dodaje ElleKit (zamiennik Substrate) podczas podpisywania."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перехватывает через CydiaSubstrate. Приложение его не содержит, поэтому RyukSign автоматически добавляет ElleKit (замену Substrate) при подписи."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CydiaSubstrate üzerinden hook yapar. Uygulama bunu içermiyor, bu yüzden RyukSign imzalarken otomatik olarak ElleKit (bir Substrate alternatifi) ekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hook qua CydiaSubstrate. Ứng dụng không có sẵn nó, nên RyukSign tự động thêm ElleKit (bản thay thế Substrate) khi ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 CydiaSubstrate 进行 hook。应用未包含它，因此 RyukSign 会在签名时自动添加 ElleKit（一个 Substrate 替代品）。"
          }
        }
      }
    },
    "Icons and web data RyukSign downloaded. Rebuilt as you browse." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيقونات وبيانات ويب نزّلها RyukSign. يُعاد بناؤها أثناء التصفح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

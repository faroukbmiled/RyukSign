    "Choose how downloads are displayed in the app. Floating icon is the default and provides a convenient draggable interface." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كيفية عرض التنزيلات في التطبيق. الأيقونة العائمة هي الخيار الافتراضي وتوفر واجهة قابلة للسحب ومريحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte, jak se v aplikaci zobrazují stahování. Plovoucí ikona je výchozí a poskytuje pohodlné přetahovatelné rozhraní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Downloads in der App angezeigt werden. Das schwebende Symbol ist die Standardeinstellung und bietet eine praktische, verschiebbare Oberfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo se muestran las descargas en la app. El icono flotante es el predeterminado y ofrece una interfaz arrastrable cómoda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la façon dont les téléchargements s’affichent dans l’app. L’icône flottante est l’option par défaut et offre une interface déplaçable pratique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih cara unduhan ditampilkan di aplikasi. Ikon mengambang adalah default dan menyediakan antarmuka yang mudah digeser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli come vengono visualizzati i download nell'app. L'icona fluttuante è l'impostazione predefinita e offre un'interfaccia trascinabile pratica."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz sposób wyświetlania pobierań w aplikacji. Pływająca ikona jest opcją domyślną i zapewnia wygodny, przeciągalny interfejs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, как загрузки отображаются в приложении. Плавающий значок используется по умолчанию и даёт удобный перетаскиваемый интерфейс."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmelerin uygulamada nasıl gösterileceğini seçin. Yüzen simge varsayılandır ve kullanışlı, sürüklenebilir bir arayüz sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn cách hiển thị tải xuống trong ứng dụng. Biểu tượng nổi là mặc định và cung cấp giao diện kéo thả tiện lợi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择下载在应用中的显示方式。浮动图标为默认方式，提供便捷的可拖动界面。"
          }
        }
      }
    },
    "Choose the color theme for the download overlay. Greyish theme provides a softer appearance in dark mode." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر سمة الألوان لطبقة التنزيل. توفر السمة الرمادية مظهرًا أنعم في الوضع الداكن."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvolte barevné téma pro překryv stahování. Šedavé téma poskytuje jemnější vzhled v tmavém režimu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Farbschema für das Download-Overlay. Das gräuliche Schema sorgt für ein weicheres Erscheinungsbild im Dunkelmodus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el tema de color para la superposición de descargas. El tema grisáceo ofrece un aspecto más suave en modo oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le thème de couleur de la superposition de téléchargement. Le thème grisâtre offre un aspect plus doux en mode sombre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tema warna untuk overlay unduhan. Tema keabu-abuan memberikan tampilan yang lebih lembut di mode gelap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il tema cromatico per l'overlay dei download. Il tema grigiastro offre un aspetto più morbido in modalità scura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz motyw kolorystyczny nakładki pobierania. Szarawy motyw zapewnia łagodniejszy wygląd w trybie ciemnym."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите цветовую тему для оверлея загрузок. Сероватая тема выглядит мягче в тёмном режиме."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirme katmanı için renk temasını seçin. Grimsi tema, koyu modda daha yumuşak bir görünüm sağlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn giao diện màu cho lớp phủ tải xuống. Giao diện xám nhạt cho vẻ ngoài dịu hơn ở chế độ tối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择下载浮层的配色主题。灰色主题在深色模式下外观更柔和。"
          }
        }
      }
    },

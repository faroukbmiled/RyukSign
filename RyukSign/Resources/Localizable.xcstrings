    "Only apps updated on or after this date are sent by the repository server." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل خادم المستودع التطبيقات المُحدّثة في هذا التاريخ أو بعده فقط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repozitáře pošle jen aplikace aktualizované od tohoto data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Repository-Server sendet nur Apps, die an oder nach diesem Datum aktualisiert wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only apps updated on or after this date are sent by the repository server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor del repositorio solo envía apps actualizadas en esta fecha o después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur du dépôt n'envoie que les applications mises à jour à partir de cette date."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repositori hanya mengirim aplikasi yang diperbarui pada atau setelah tanggal ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server del repository invia solo le app aggiornate a partire da questa data."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer repozytorium wysyła tylko aplikacje zaktualizowane w tym dniu lub później."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер репозитория отправляет только приложения, обновлённые с этой даты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

    "Set a password — until you do, the server stays open to anyone on the network." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن كلمة مرور — إلى أن تفعل ذلك، يظل الخادم مفتوحاً لأي شخص على الشبكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte heslo — dokud to neuděláte, server zůstává otevřený komukoli v síti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Passwort fest — bis dahin bleibt der Server für jeden im Netzwerk offen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a password — until you do, the server stays open to anyone on the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece una contraseña — hasta entonces, el servidor permanece abierto a cualquiera en la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un mot de passe — tant que ce n'est pas fait, le serveur reste ouvert à tous sur le réseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur kata sandi — sampai Anda melakukannya, server tetap terbuka untuk siapa pun di jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una password — finché non lo fai, il server resta aperto a chiunque sulla rete."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw hasło — dopóki tego nie zrobisz, serwer pozostaje otwarty dla każdego w sieci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте пароль — пока вы этого не сделаете, сервер открыт для всех в сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şifre belirleyin — belirleyene kadar sunucu ağdaki herkese açık kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt mật khẩu — cho đến khi bạn làm vậy, máy chủ vẫn mở cho bất kỳ ai trong mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请设置密码 — 在此之前，服务器对网络中的任何人开放。"
          }
        }
      }
    },

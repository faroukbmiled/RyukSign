    "Uses a custom grey color in dark mode, white in light mode" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم لونًا رماديًا مخصصًا في الوضع الداكن، وأبيض في الوضع الفاتح"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používá vlastní šedou barvu v tmavém režimu, bílou ve světlém režimu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet ein eigenes Grau im Dunkelmodus und Weiß im Hellmodus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un color gris personalizado en modo oscuro y blanco en modo claro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise un gris personnalisé en mode sombre, du blanc en mode clair"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan warna abu-abu khusus di mode gelap, putih di mode terang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un colore grigio personalizzato in modalità scura, bianco in modalità chiara"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa niestandardowego szarego koloru w trybie ciemnym, białego w trybie jasnym"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует особый серый цвет в тёмном режиме и белый в светлом"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koyu modda özel bir gri renk, açık modda beyaz kullanır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng màu xám tùy chỉnh ở chế độ tối, trắng ở chế độ sáng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在深色模式下使用自定义灰色，在浅色模式下使用白色"
          }
        }
      }
    },
    "Uses a darker grey color in dark mode, white in light mode" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة فتح مُنتقي ‏«حفظ في الملفات» عند آخر مجلد استخدمته بدلًا من البدء دائمًا من مجلد مستندات RyukSign."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu otevře výběr Uložit do Souborů v naposledy použité složce místo toho, aby vždy začínal ve složce dokumentů RyukSign."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet die Auswahl „In Dateien sichern“ wieder im zuletzt verwendeten Ordner, statt immer im RyukSign-Dokumentenordner zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reopen the Save to Files picker at the last folder you used instead of always starting at the RyukSign documents folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a abrir el selector Guardar en Archivos en la última carpeta usada en lugar de empezar siempre en la carpeta de documentos de RyukSign."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rouvre le sélecteur « Enregistrer dans Fichiers » sur le dernier dossier utilisé au lieu de toujours démarrer dans le dossier de documents RyukSign."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka kembali pemilih Simpan ke Berkas di folder terakhir yang Anda gunakan alih-alih selalu mulai di folder dokumen RyukSign."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riapre il selettore Salva su File nell’ultima cartella usata invece di partire sempre dalla cartella documenti di RyukSign."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponownie otwiera wybór Zapisz w Plikach w ostatnio używanym folderze zamiast zawsze zaczynać w folderze dokumentów RyukSign."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывать выбор «Сохранить в Файлы» в последней использованной папке вместо того, чтобы всегда начинать с папки документов RyukSign."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyalara Kaydet seçiciyi her zaman RyukSign belgeler klasöründe başlatmak yerine en son kullandığınız klasörde yeniden açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở lại bộ chọn Lưu vào Tệp tại thư mục bạn dùng gần nhất thay vì luôn bắt đầu ở thư mục tài liệu RyukSign."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你上次使用的文件夹重新打开“存储到文件”选择器，而不是总是从 RyukSign 文档文件夹开始。"
          }
        }
      }
    },

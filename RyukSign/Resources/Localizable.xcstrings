    "Removing the provisioning file will exclude the mobileprovision file from being embedded inside of the application when signing, to help prevent any detection." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إزالة ملف Provisioning ستمنع تضمين ملف mobileprovision داخل التطبيق أثناء التوقيع، مما يساعد على تقليل احتمالية اكتشافه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranění provisioning souboru vyloučí mobileprovision soubor z vložení do aplikace při podepisování, což pomáhá zabránit detekci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Entfernen der Provisioning-Datei wird die mobileprovision-Datei beim Signieren nicht in die App eingebettet, um eine Erkennung zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing the provisioning file will exclude the mobileprovision file from being embedded inside of the application when signing, to help prevent any detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar el archivo de aprovisionamiento excluirá el archivo mobileprovision de incrustarse en la aplicación al firmar, para ayudar a evitar cualquier detección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le fichier de provisioning exclura le fichier mobileprovision de l'intégration dans l'application lors de la signature, afin d'aider à prévenir toute détection."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus berkas provisioning akan mengecualikan berkas mobileprovision dari penyematan di dalam aplikasi saat penandatanganan, untuk membantu mencegah deteksi apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere il file di provisioning escluderà il file .mobileprovision dall’essere incorporato nell’app durante la firma, aiutando così a evitare qualsiasi rilevamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie pliku provisioning spowoduje, że plik mobileprovision nie będzie osadzony w aplikacji podczas podpisywania, co zapobiegnie jakiemukolwiek wykryciu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление файла provisioning исключит встраивание файла mobileprovision в приложение при подписи, чтобы предотвратить обнаружение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazırlık profilinin kaldırılması imzalama sırasında “mobileprovision” dosyasının uygulamaya dahil edilmemesini sağlayarak herhangi bir tespitin önlenmesine yardımcı olur. "
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tệp mobileprovision được nhúng bên trong ứng dụng khi ký, giúp ngăn chặn mọi phát hiện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除描述文件后，签名时就不会将其嵌入到App中，从而防止被检测到。"
          }
        }
      }
    },

    "Replaces wildcard keychain groups with the app's bundle identifier, preventing sideloaded apps from accessing each other's keychain entries." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل مجموعات سلسلة المفاتيح ذات الحرف البدل بمعرّف حزمة التطبيق، مانعاً التطبيقات المثبّتة جانبياً من الوصول إلى إدخالات سلسلة المفاتيح الخاصة ببعضها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahradí zástupné skupiny klíčenky identifikátorem balíčku aplikace a zabrání tak bočně načteným aplikacím v přístupu k záznamům klíčenky ostatních aplikací."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt Platzhalter-Schlüsselbundgruppen durch den Bundle-Identifier der App und verhindert so, dass quergeladene Apps auf die Schlüsselbundeinträge anderer Apps zugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replaces wildcard keychain groups with the app's bundle identifier, preventing sideloaded apps from accessing each other's keychain entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye los grupos de llavero con comodín por el identificador de paquete de la app, evitando que las apps instaladas externamente accedan a las entradas de llavero de otras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace les groupes de trousseau génériques par l'identifiant de l'app, empêchant les apps sideloadées d'accéder aux entrées de trousseau des autres."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengganti grup keychain wildcard dengan pengidentifikasi bundel aplikasi, mencegah aplikasi sideload saling mengakses entri keychain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce i gruppi portachiavi con caratteri jolly con l'identificatore bundle dell'app, impedendo alle app installate lateralmente di accedere alle voci portachiavi altrui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje grupy pęku kluczy z symbolami wieloznacznymi identyfikatorem pakietu aplikacji, uniemożliwiając bocznie ładowanym aplikacjom dostęp do wpisów pęku kluczy innych aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменяет шаблонные группы связки ключей идентификатором пакета приложения, не давая сторонним приложениям доступ к записям связки ключей друг друга."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joker karakterli anahtar zinciri gruplarını uygulamanın paket tanımlayıcısıyla değiştirir; yandan yüklenen uygulamaların birbirinin anahtar zinciri girişlerine erişmesini önler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay thế các nhóm keychain ký tự đại diện bằng mã định danh gói của ứng dụng, ngăn các ứng dụng cài đặt ngoài truy cập mục keychain của nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用应用的捆绑标识符替换通配符钥匙串组，防止旁加载的应用互相访问对方的钥匙串条目。"
          }
        }
      }
    },

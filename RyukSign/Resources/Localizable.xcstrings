    "Copies saved every time you export or share an IPA. They are not needed to keep or install the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ تُحفظ في كل مرة تصدّر فيها ملف IPA أو تشاركه. ليست ضرورية للاحتفاظ بالتطبيق أو تثبيته."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",

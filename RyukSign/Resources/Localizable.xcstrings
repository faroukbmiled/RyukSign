        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbole und Webdaten, die RyukSign geladen hat. Werden beim Blättern neu aufgebaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Icons and web data RyukSign downloaded. Rebuilt as you browse."

    "You're about to add %lld items to your Tweak Manager. Many of these are usually part of the app, not tweaks." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت على وشك إضافة %lld عنصر إلى Tweak Manager. كثير من هذه العناصر عادةً جزء من التطبيق وليست تعديلات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chystáte se přidat %lld položek do Tweak Manageru. Mnoho z nich je obvykle součástí aplikace, ne tweaky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist dabei, %lld Elemente zu deinem Tweak Manager hinzuzufügen. Viele davon gehören normalerweise zur App, nicht zu den Tweaks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a punto de añadir %lld elementos a tu Tweak Manager. Muchos de estos suelen formar parte de la app, no son tweaks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur le point d’ajouter %lld éléments à votre Tweak Manager. Beaucoup d’entre eux font généralement partie de l’app, et non des tweaks."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan menambahkan %lld item ke Tweak Manager Anda. Banyak di antaranya biasanya bagian dari aplikasi, bukan tweak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per aggiungere %lld elementi al Tweak Manager. Molti di questi di solito fanno parte dell'app, non sono tweak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamierzasz dodać %lld elementów do Tweak Managera. Wiele z nich to zwykle część aplikacji, a nie tweaki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы собираетесь добавить %lld элементов в Tweak Manager. Многие из них обычно являются частью приложения, а не твиками."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

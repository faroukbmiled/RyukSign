    "By default, localized titles for the app won't be changed, however this option overrides it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بشكل افتراضي، لن يتم تغيير العناوين المترجمة للتطبيق، لكن هذا الخيار يتجاوز ذلك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím nastavení se lokalizované názvy aplikace nemění, tato možnost to však přepíše."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig, werden lokalisierte Titel für diese App nicht geändert, jedoch kann diese Option dies überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By default, localized titles for the app won't be changed, however this option overrides it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De forma predeterminada, los títulos localizados de la app no se modifican, pero esta opción lo anula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, les titres localisés de l'app ne sont pas modifiés, mais cette option passe outre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secara bawaan, judul terlokalisasi untuk aplikasi tidak akan diubah, namun opsi ini menggantinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di default, i titoli tradotti delle app non cambieranno, ma questa opzione lo sostituisce."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie tłumaczone tytuły aplikacji nie będą zmieniane, jednak ta opcja to nadpisuje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию локализованные названия приложения не меняются, однако эта опция переопределяет это."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak, uygulamanın yerelleştirilmiş başlıkları değiştirilmeyecektir, ancak bu seçenek bunu geçersiz kılar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo mặc định, tiêu đề bản địa hóa cho ứng dụng sẽ không bị thay đổi, tuy nhiên tùy chọn này sẽ ghi đè lên nó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在默认情况下，应用的本地化标题保持不变。此选项将取消这一限制。"
          }
        }
      }
    },

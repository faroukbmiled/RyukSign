        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke kiri untuk mengatur ulang. Repositori premium tidak dapat dihapus satu per satu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per reimpostare. I repository premium non possono essere eliminati singolarmente."

    },
    "Only the newest apps are sent by the repository server, so premium repositories load much faster." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل خادم المستودع أحدث التطبيقات فقط، لذا تُحمّل المستودعات المميزة أسرع بكثير."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server repozitáře pošle jen nejnovější aplikace, takže se prémiové repozitáře načtou mnohem rychleji."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

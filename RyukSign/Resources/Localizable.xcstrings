    "Used by every file above that doesn't have its own custom settings. Pick the injection path, folder, and which app extensions to inject into." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُستخدم لكل ملف أعلاه ليس له إعدادات مخصصة خاصة به. اختر مسار الحقن والمجلد وإضافات التطبيق المراد الحقن فيها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použito pro každý soubor výše, který nemá vlastní nastavení. Vyberte cestu injektáže, složku a do kterých rozšíření aplikace injektovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von jeder Datei oben verwendet, die keine eigenen Einstellungen hat. Wähle Injektionspfad, Ordner und in welche App-Erweiterungen injiziert werden soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado por todos los archivos de arriba que no tienen sus propios ajustes personalizados. Elige la ruta de inyección, la carpeta y en qué extensiones de la app inyectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé par chaque fichier ci-dessus qui n’a pas ses propres réglages personnalisés. Choisissez le chemin et le dossier d’injection, ainsi que les extensions d’app dans lesquelles injecter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan oleh setiap file di atas yang tidak memiliki pengaturan khususnya sendiri. Pilih path injeksi, folder, dan app extension mana yang akan diinjeksi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato da ogni file qui sopra che non ha impostazioni personalizzate proprie. Scegli il percorso di iniezione, la cartella e in quali estensioni dell'app iniettare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używane przez każdy plik powyżej, który nie ma własnych niestandardowych ustawień. Wybierz ścieżkę wstrzykiwania, folder oraz rozszerzenia aplikacji, do których wstrzykiwać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется каждым файлом выше, у которого нет собственных особых настроек. Выберите путь и папку внедрения, а также в какие расширения приложения внедрять."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıda kendi özel ayarlarına sahip olmayan her dosya tarafından kullanılır. Enjeksiyon yolunu, klasörünü ve hangi uygulama uzantılarına enjekte edileceğini seçin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được dùng bởi mọi tệp ở trên không có cài đặt tùy chỉnh riêng. Chọn đường dẫn chèn, thư mục, và những app extension nào để chèn vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于上方所有没有自己自定义设置的文件。选择注入路径、文件夹，以及要注入到哪些应用扩展。"
          }
        }
      }
    },

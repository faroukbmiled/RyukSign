    "Your key is tied to this device ID. Keep a copy of it so premium access can be restored if this install is wiped." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاحك مرتبط بمعرّف الجهاز هذا. احتفظ بنسخة منه لاستعادة الوصول المميز إذا مُسح هذا التثبيت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš klíč je vázaný na toto ID zařízení. Uschovejte si ho, abyste mohli prémiový přístup obnovit, pokud se instalace smaže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlüssel ist an diese Geräte-ID gebunden. Bewahre sie auf, damit der Premium-Zugang nach einem Löschen wiederhergestellt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your key is tied to this device ID. Keep a copy of it so premium access can be restored if this install is wiped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave está ligada a este ID de dispositivo. Guárdalo para poder restaurar el acceso premium si se borra esta instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé est liée à cet identifiant d'appareil. Conservez-le pour pouvoir restaurer l'accès premium si l'installation est effacée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci Anda terikat pada ID perangkat ini. Simpan salinannya agar akses premium bisa dipulihkan jika pemasangan ini terhapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave è legata a questo ID dispositivo. Conservane una copia per ripristinare l'accesso premium se l'installazione viene cancellata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój klucz jest powiązany z tym identyfikatorem urządzenia. Zachowaj jego kopię, aby odzyskać dostęp premium, jeśli ta instalacja zostanie usunięta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ключ привязан к этому идентификатору устройства. Сохраните его, чтобы восстановить премиум-доступ, если установка будет стёрта."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtarınız bu cihaz kimliğine bağlıdır. Bu kurulum silinirse premium erişimi geri alabilmek için bir kopyasını saklayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa của bạn gắn với ID thiết bị này. Hãy lưu lại để khôi phục quyền premium nếu bản cài đặt này bị xóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密钥与该设备 ID 绑定。请保存一份，以便本次安装被清除后恢复高级权限。"
          }
        }
      }
    },
    "Your pairing file is invalid and is incompatible with your device, please import a valid pairing file." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف pairing غير صالح وغير متوافق مع جهازك، يرجى استيراد ملف pairing صالح."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš párovací soubor je neplatný a nekompatibilní s vaším zařízením, importujte prosím platný párovací soubor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Pairing-Datei ist ungültig und ist inkompatibel mit deinem Gerät, bitte importiere eine gültige."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pairing file is invalid and is incompatible with your device, please import a valid pairing file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu archivo de emparejamiento no es válido y es incompatible con tu dispositivo; importa un archivo de emparejamiento válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fichier de jumelage est invalide et incompatible avec votre appareil, veuillez importer un fichier de jumelage valide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berkas pairing Anda tidak valid dan tidak kompatibel dengan perangkat Anda, harap impor berkas pairing yang valid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo file di abbinamento non è valido e non è compatibile con il tuo dispositivo, per favore importa un file di abbinamento valido."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plik parowania jest nieprawidłowy i niekompatybilny z urządzeniem. Zaimportuj poprawny plik."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш файл сопряжения недействителен и несовместим с вашим устройством, импортируйте действительный файл сопряжения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleştirme dosyanız geçersiz ve cihazınızla uyumlu değil. Lütfen geçerli bir eşleştirme dosyası içe aktarın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp ghép nối của bạn không hợp lệ và không tương thích với thiết bị của bạn, vui lòng nhập tệp ghép nối hợp lệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对文件不可用并且与设备不匹配，请导入可用的的配置文件。"
          }
        }
      }
    },
    "Your premium access is active. Premium repositories are protected and cannot be deleted individually. Swipe left or tap Reset to deactivate." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصولك المميز نشط. المستودعات المميزة محمية ولا يمكن حذفها بشكل فردي. اسحب لليسار أو اضغط إعادة تعيين لإلغاء التفعيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš premium přístup je aktivní. Premium repozitáře jsou chráněné a nelze je mazat jednotlivě. Přejeďte vlevo nebo klepněte na Reset pro deaktivaci."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Premium-Zugang ist aktiv. Premium-Repositories sind geschützt und können nicht einzeln gelöscht werden. Wische nach links oder tippe auf Zurücksetzen, um ihn zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu acceso premium está activo. Los repositorios premium están protegidos y no se pueden eliminar individualmente. Desliza a la izquierda o toca Restablecer para desactivarlo."

    "Tweaks pulled in by auto-inject rules. Tap one to choose exactly where it injects." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديلات مُضافة عبر قواعد الحقن التلقائي. اضغط على واحد لاختيار مكان حقنه بالضبط."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaky zahrnuté pravidly automatické injektáže. Klepnutím vyberete přesně, kam se injektuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaks, die durch Auto-Injektionsregeln einbezogen werden. Tippe auf einen, um genau festzulegen, wohin er injiziert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaks incluidos por las reglas de inyección automática. Toca uno para elegir exactamente dónde se inyecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaks ajoutés par les règles d’auto-injection. Touchez-en un pour choisir exactement où il s’injecte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweak yang ditarik oleh aturan injeksi otomatis. Ketuk salah satu untuk memilih dengan tepat di mana ia diinjeksikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweak inclusi dalle regole di iniezione automatica. Toccane uno per scegliere esattamente dove viene iniettato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tweaki dodane przez reguły automatycznego wstrzykiwania. Dotknij jednego, aby wybrać dokładne miejsce wstrzyknięcia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твики, добавленные по правилам автовнедрения. Нажмите на один, чтобы выбрать точное место внедрения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",

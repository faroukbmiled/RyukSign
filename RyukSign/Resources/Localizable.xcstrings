    "Check what is using space, back up your setup, or reset the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق مما يستهلك المساحة، أو انسخ إعداداتك احتياطيًا، أو أعد تعيين التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {

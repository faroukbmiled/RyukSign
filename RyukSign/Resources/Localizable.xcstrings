    "Anything outside RyukSign's own folders, including files you added yourself. The app database is locked so it can't be deleted here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي شيء خارج مجلدات RyukSign، بما في ذلك الملفات التي أضفتها بنفسك. قاعدة بيانات التطبيق مقفلة فلا يمكن حذفها هنا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cokoli mimo vlastní složky RyukSign, včetně souborů, které jste přidali sami. Databáze aplikace je zamčená, takže ji tu nelze smazat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles außerhalb der eigenen Ordner von RyukSign, auch selbst hinzugefügte Dateien. Die App-Datenbank ist gesperrt und kann hier nicht gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anything outside RyukSign's own folders, including files you added yourself. The app database is locked so it can't be deleted here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que está fuera de las carpetas propias de RyukSign, incluidos los archivos que añadiste tú. La base de datos de la app está bloqueada y no se puede borrar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui se trouve hors des dossiers propres à RyukSign, y compris les fichiers que vous avez ajoutés. La base de données de l'app est verrouillée et ne peut pas être supprimée ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa pun di luar folder milik RyukSign, termasuk berkas yang Anda tambahkan sendiri. Basis data aplikasi terkunci sehingga tidak bisa dihapus di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che sta fuori dalle cartelle di RyukSign, inclusi i file che hai aggiunto tu. Il database dell'app è bloccato e non si può eliminare qui."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko poza własnymi folderami RyukSign, w tym pliki dodane przez Ciebie. Baza danych aplikacji jest zablokowana i nie można jej tu usunąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что находится за пределами собственных папок RyukSign, включая добавленные вами файлы. База данных приложения заблокирована и не может быть удалена здесь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RyukSign'ın kendi klasörleri dışındaki her şey, kendi eklediğiniz dosyalar dahil. Uygulama veritabanı kilitlidir, burada silinemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ nằm ngoài các thư mục riêng của RyukSign, kể cả tệp bạn tự thêm vào. Cơ sở dữ liệu ứng dụng bị khóa nên không thể xóa ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RyukSign 自有文件夹之外的所有内容，包括你自己添加的文件。应用数据库已锁定，无法在此删除。"
          }
        }
      }
    },

    "Saves what you pick to one file. Signed and imported apps aren't included." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ ما تختاره في ملف واحد. لا تُضمَّن التطبيقات الموقَّعة والمستوردة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloží vybrané položky do jednoho souboru. Podepsané a importované aplikace nejsou zahrnuty."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert deine Auswahl in einer Datei. Signierte und importierte Apps sind nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves what you pick to one file. Signed and imported apps aren't included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda lo que elijas en un solo archivo. Las apps firmadas e importadas no se incluyen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre votre sélection dans un seul fichier. Les apps signées et importées ne sont pas incluses."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan pilihan Anda ke satu berkas. Aplikasi yang ditandatangani dan diimpor tidak disertakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva ciò che scegli in un unico file. Le app firmate e importate non sono incluse."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje wybrane elementy do jednego pliku. Podpisane i zaimportowane aplikacje nie są uwzględniane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет выбранное в один файл. Подписанные и импортированные приложения не включаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiklerinizi tek bir dosyaya kaydeder. İmzalanmış ve içe aktarılmış uygulamalar dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu những gì bạn chọn vào một tệp. Ứng dụng đã ký và đã nhập không được bao gồm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你选择的内容保存为一个文件。不包含已签名和已导入的应用。"
          }
        }
      }
    },
    "Scan the code to open the upload page, or mount the WebDAV address in Finder (Go → Connect to Server) or the Files app." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز لفتح صفحة الرفع، أو ركّب عنوان WebDAV في Finder ‏(الانتقال ← الاتصال بالخادم) أو في تطبيق الملفات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte kód pro otevření stránky nahrávání, nebo připojte adresu WebDAV ve Finderu (Otevřít → Připojit k serveru) či v aplikaci Soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code, um die Upload-Seite zu öffnen, oder binde die WebDAV-Adresse im Finder (Gehe zu → Mit Server verbinden) oder in der Dateien-App ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código para abrir la página de subida, o monta la dirección WebDAV en Finder (Ir → Conectarse al servidor) o en la app Archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code pour ouvrir la page de téléversement, ou montez l’adresse WebDAV dans le Finder (Aller → Se connecter au serveur) ou dans l’app Fichiers."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai kode untuk membuka halaman unggah, atau pasang alamat WebDAV di Finder (Go → Connect to Server) atau aplikasi Files."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona il codice per aprire la pagina di caricamento, oppure monta l'indirizzo WebDAV nel Finder (Vai → Connessione al server) o nell'app File."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj kod, aby otworzyć stronę przesyłania, lub zamontuj adres WebDAV w Finderze (Idź → Połącz z serwerem) albo w aplikacji Pliki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте код, чтобы открыть страницу загрузки, или подключите адрес WebDAV в Finder («Переход» → «Подключение к серверу») либо в приложении «Файлы»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme sayfasını açmak için kodu tarayın ya da WebDAV adresini Finder'da (Git → Sunucuya Bağlan) veya Dosyalar uygulamasında bağlayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quét mã để mở trang tải lên, hoặc gắn địa chỉ WebDAV trong Finder (Go → Connect to Server) hoặc ứng dụng Files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

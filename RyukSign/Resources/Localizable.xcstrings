    "Sign with the certificate you first installed RyukSign with, or iOS won't update it in place." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقّع بالشهادة التي ثبّت بها RyukSign في البداية، وإلا فلن يحدّثه iOS في مكانه."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podepište certifikátem, kterým jste RyukSign původně nainstalovali, jinak jej iOS neaktualizuje na místě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signiere mit dem Zertifikat, mit dem du RyukSign ursprünglich installiert hast, sonst aktualisiert iOS es nicht direkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign with the certificate you first installed RyukSign with, or iOS won't update it in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma con el certificado con el que instalaste RyukSign por primera vez, o iOS no lo actualizará en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signez avec le certificat utilisé lors de la première installation de RyukSign, sinon iOS ne le mettra pas à jour sur place."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanda tangani dengan sertifikat yang Anda gunakan saat pertama memasang RyukSign, atau iOS tidak akan memperbaruinya di tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma con il certificato con cui hai installato RyukSign la prima volta, altrimenti iOS non lo aggiornerà sul posto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpisz certyfikatem, którym pierwotnie zainstalowano RyukSign, w przeciwnym razie iOS nie zaktualizuje go w miejscu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпишите тем сертификатом, которым вы изначально установили RyukSign, иначе iOS не обновит его на месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RyukSign'i ilk kurduğunuz sertifikayla imzalayın, aksi halde iOS onu yerinde güncellemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ký bằng chứng chỉ bạn đã dùng khi cài RyukSign lần đầu, nếu không iOS sẽ không cập nhật tại chỗ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用你最初安装 RyukSign 时所用的证书签名，否则 iOS 不会就地更新。"
          }
        }
      }
    },

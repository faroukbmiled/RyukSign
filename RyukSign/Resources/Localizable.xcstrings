    "Left behind by imports and signings that got interrupted. Nothing uses them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلّفتها عمليات استيراد وتوقيع توقفت. لا شيء يستخدمها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbylo po přerušených importech a podepisování. Nic je nepoužívá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von abgebrochenen Importen und Signierungen übrig. Nichts benutzt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Left behind by imports and signings that got interrupted. Nothing uses them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedaron de importaciones y firmas interrumpidas. Nada las usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restes d'imports et de signatures interrompus. Rien ne les utilise."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tertinggal dari impor dan penandatanganan yang terhenti. Tidak ada yang memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimasti da importazioni e firme interrotte. Niente li usa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostały po przerwanych importach i podpisywaniu. Nic ich nie używa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остались после прерванных импортов и подписаний. Ими ничего не пользуется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarıda kalan içe aktarma ve imzalamalardan kaldı. Hiçbir şey kullanmıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn lại từ những lần nhập và ký bị gián đoạn. Không có gì dùng đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入和签名中断后遗留下来的。没有任何东西在用。"
          }
        }
      }
    },

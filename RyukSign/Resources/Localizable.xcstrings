          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDevice: Das Update wird auf dem Gerät signiert und über eine Pairing-Datei installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDevice: the update is signed on-device and installed over a pairing file."
          }
        },
        "es" : {
          "stringUnit" : {
